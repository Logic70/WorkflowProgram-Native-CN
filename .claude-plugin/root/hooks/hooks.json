{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap-python-runtime.py\" --sessionstart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/workflowprogram-foreground-guard.py\" check"
          }
        ]
      }
    ]
  }
}
